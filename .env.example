# Skylimit Estates — environment variables
# Postgres connection string (Supabase)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Login password for the app (the access gate)
ACCESS_KEY=change-me

# OpenAI API key — powers the AI certificate checker and maintenance troubleshooting
OPENAI_API_KEY=sk-...

# Optional: override the OpenAI model (defaults to gpt-4o)
# OPENAI_MODEL=gpt-4o

# Set by the platform automatically
NODE_ENV=production
# PORT is provided by the host
